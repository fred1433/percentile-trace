# Transaction pooler (port 6543). Used by the application at runtime.
DATABASE_URL=postgresql://<role>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Session pooler (port 5432). Used by bench/explain.mjs, which needs a plain
# session for EXPLAIN (ANALYZE, BUFFERS) and for reading query statistics.
DATABASE_URL_SESSION=postgresql://<role>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Printed in the report so a number is never separated from where its database lives.
PT_DB_REGION=us-east-1
